local function keyforgeTamperCheck()
    local function fail(code)
        error("[SKID] : " .. code, 0)
    end

    if typeof ~= "function" then
        fail("TYPEOF_MISSING")
    end

    if typeof(game) ~= "Instance" then
        fail("GAME_INVALID")
    end

    if typeof(workspace) ~= "Instance" then
        fail("WORKSPACE_INVALID")
    end

    if type(task) ~= "table" or type(task.wait) ~= "function" then
        fail("TASK_INVALID")
    end

    if type(Instance) ~= "table" or type(Instance.new) ~= "function" then
        fail("INSTANCE_INVALID")
    end

    local ok, players = pcall(function()
        return game:GetService("Players")
    end)

    if not ok or not players then
        fail("PLAYERS_SERVICE_INVALID")
    end

    -- Optional executor API diagnostics; these are not
    -- required by standard Roblox LocalScripts.
    local env = (getgenv and getgenv()) or _G
    local diagnostics = {
        request = type(env.request) == "function",
        http_request = type(env.http_request) == "function",
        readfile = type(env.readfile) == "function",
        writefile = type(env.writefile) == "function",
        hookfunction = type(env.hookfunction) == "function",
        identifyexecutor = type(env.identifyexecutor) == "function",
        getexecutorname = type(env.getexecutorname) == "function"
    }

    return true, diagnostics
end

return keyforgeTamperCheck()
